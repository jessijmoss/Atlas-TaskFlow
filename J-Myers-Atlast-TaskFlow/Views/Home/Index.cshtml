@{
    ViewData["Title"] = "Home - Atlas TaskFlow";
}

<div class="p-5 mb-4 bg-light rounded-3 border">
    <div class="container-fluid py-3">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="badge bg-primary px-3 py-2 fs-6">Prior Authorization Hub</span>
            <span class="badge bg-success px-3 py-2 fs-6">Zero PHI </span>
        </div>
        <h1 class="display-5 fw-bold text-dark">Atlas TaskFlow</h1>
        <p class="col-md-9 fs-5 text-muted">
            Eliminate outpatient prior authorization confusions, dropped requests, and missed deadlines.
            Atlas TaskFlow centralizes clinical tracking, automates deadline aging, and streamlines desk-to-desk communication.
        </p>
        <hr class="my-4" />
        <div class="d-flex gap-3">
            <a class="btn btn-primary btn-lg px-4" asp-area="Identity" asp-page="/Account/Register">Get Started / Register</a>
            <a class="btn btn-outline-secondary btn-lg px-4" asp-area="Identity" asp-page="/Account/Login">Sign In</a>
        </div>
    </div>
</div>

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 bg-white p-3">
            <div class="card-body">
                <h5 class="card-title text-primary fw-bold">From Initiated to Approved in 5 steps</h5>
                <p class="card-text text-muted">
                    Track requests through five discrete operational stages: Initiation, Clinicals Submitted, Submitted to Payer, Pending Determination, and Closed.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 bg-white p-3">
            <div class="card-body">
                <h5 class="card-title text-warning fw-bold">Deadline Aging Engine</h5>
                <p class="card-text text-muted">
                    Automated color-coded badges highlight impending payer cutoffs: Green (&gt;48h), Yellow (&le;48h), and Critical Red (&le;24h) to avoid untimely claim denials.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 bg-white p-3">
            <div class="card-body">
                <h5 class="card-title text-success fw-bold">Audit-Ready Documentation</h5>
                <p class="card-text text-muted">
                    Chronological notes and downloadable finalized reports cross-referenced by Patient Case Number (PCN) for fast EMR chart uploads.
                </p>
            </div>
        </div>
    </div>
</div>