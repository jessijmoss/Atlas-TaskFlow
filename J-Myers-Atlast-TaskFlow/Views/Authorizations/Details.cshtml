@model J_Myers_Atlast_TaskFlow.Models.AuthorizationTask

@{
    ViewData["Title"] = "Authorization Details";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="fw-bold text-dark mb-0">Authorization Case Details</h2>
                <span class="badge bg-primary fs-6">@Model.Stage</span>
            </div>
            <hr />

            <dl class="row mt-3">
                <dt class="col-sm-4 text-muted">Patient Case Number</dt>
                <dd class="col-sm-8 fw-bold">@Model.PatientCaseNumber</dd>

                <dt class="col-sm-4 text-muted">CPT Code</dt>
                <dd class="col-sm-8">@Model.CptCode</dd>

                <dt class="col-sm-4 text-muted">Workflow Stage</dt>
                <dd class="col-sm-8">@Model.Stage</dd>

                <dt class="col-sm-4 text-muted">Due Date</dt>
                <dd class="col-sm-8">@Model.DueDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-4 text-muted">Status</dt>
                <dd class="col-sm-8">@(Model.IsCompleted ? "Completed" : "Active / In Progress")</dd>

                <dt class="col-sm-4 text-muted">Clinical Notes</dt>
                <dd class="col-sm-8">@Model.Notes</dd>
            </dl>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Back to Dashboard</a>
                <a asp-action="Edit" asp-route-id="@Model.TaskId" class="btn btn-primary px-4">Edit Case</a>
            </div>
        </div>
    </div>
</div>