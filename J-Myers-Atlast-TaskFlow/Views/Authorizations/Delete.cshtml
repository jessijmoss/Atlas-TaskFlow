@model J_Myers_Atlast_TaskFlow.Models.AuthorizationTask

@{
    ViewData["Title"] = "Delete Authorization Task";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 p-4">
            <h2 class="fw-bold text-danger mb-2">Delete Authorization Case</h2>
            <p class="text-muted mb-4">Are you sure you want to permanently remove this prior authorization record?</p>
            <hr />

            <dl class="row">
                <dt class="col-sm-4 text-muted">Patient Case Number</dt>
                <dd class="col-sm-8 fw-bold">@Model.PatientCaseNumber</dd>

                <dt class="col-sm-4 text-muted">CPT Code</dt>
                <dd class="col-sm-8">@Model.CptCode</dd>

                <dt class="col-sm-4 text-muted">Stage</dt>
                <dd class="col-sm-8">@Model.Stage</dd>

                <dt class="col-sm-4 text-muted">Due Date</dt>
                <dd class="col-sm-8">@Model.DueDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-4 text-muted">Notes</dt>
                <dd class="col-sm-8">@Model.Notes</dd>
            </dl>

            <form asp-action="Delete" method="post" class="d-flex justify-content-between mt-4">
                <input type="hidden" asp-for="TaskId" />
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
            </form>
        </div>
    </div>
</div>